 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Clinical Note Clarification Assistant - Experiment & Evaluation Notebook\n",
    "\n",
    "This notebook executes the benchmark experiment comparing the **Baseline Rule-Based System** against the **Proposed Explainable Assistant** on a 70/15/15 split of the 1,200 synthetic consultation note dataset.\n",
    "\n",
    "## Primary Target Metric:\n",
    "**Pre-Departure Ambiguity Detection Rate (PDADR)** = Correctly identified ambiguous follow-up instructions / Total ambiguous follow-up instructions * 100"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.model_selection import train_test_split\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Set path\n",
    "sys.path.append(os.path.abspath('../'))\n",
    "from rules.ambiguity_rules import BaselineAmbiguityDetector, ProposedAmbiguityAssistant"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Synthetic Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data_path = '../data/synthetic_consultation_notes.csv'\n",
    "df = pd.read_csv(data_path)\n",
    "print(f\"Dataset shape: {df.shape}\")\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Train / Validation / Test Split (70 / 15 / 15)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df_train, df_temp = train_test_split(df, test_size=0.30, random_state=42, stratify=df['Ambiguity_Type'])\n",
    "df_val, df_test = train_test_split(df_temp, test_size=0.50, random_state=42, stratify=df_temp['Ambiguity_Type'])\n",
    "\n",
    "print(f\"Train set: {len(df_train)} records\")\n",
    "print(f\"Validation set: {len(df_val)} records\")\n",
    "print(f\"Test set: {len(df_test)} records\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Benchmark Evaluation: Baseline vs Proposed"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from evaluation.run_experiment import calculate_metrics\n",
    "\n",
    "baseline = BaselineAmbiguityDetector()\n",
    "proposed = ProposedAmbiguityAssistant()\n",
    "\n",
    "y_true = df_test['Ambiguous_Flag'].values\n",
    "\n",
    "# Baseline\n",
    "y_pred_base = [1 if baseline.analyze(row['Clinical_Note'])['is_ambiguous'] else 0 for _, row in df_test.iterrows()]\n",
    "# Proposed\n",
    "y_pred_prop = [1 if proposed.analyze(row['Clinical_Note'], row['Planned_Action'])['is_ambiguous'] else 0 for _, row in df_test.iterrows()]\n",
    "\n",
    "metrics_base = calculate_metrics(y_true, np.array(y_pred_base), df_test, is_proposed=False)\n",
    "metrics_prop = calculate_metrics(y_true, np.array(y_pred_prop), df_test, is_proposed=True, proposed_assistant=proposed)\n",
    "\n",
    "results_df = pd.DataFrame([\n",
    "    {\"System\": \"Baseline System\", **metrics_base},\
    "    {\"System\": \"Proposed Assistant\", **metrics_prop}\n",
    "])\n",
    "\n",
    "results_df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Visualization & Comparison"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(10, 5))\n",
    "sns.barplot(data=results_df.melt(id_vars=['System'], value_vars=['PDADR', 'Accuracy', 'F1_Score', 'Urgent_Case_Recall']),\n",
    "            x='variable', y='value', hue='System', palette='viridis')\n",
    "plt.title('Benchmark Performance Comparison (%)')\n",
    "plt.ylabel('Percentage (%)')\n",
    "plt.xlabel('Metric')\n",
    "plt.ylim(0, 105)\n",
    "plt.axhline(90, color='red', linestyle='--', label='PDADR Target (90%)')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  }
 ],
